<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#F04A13">

            <Button
                android:id="@+id/detailBackButton"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_centerVertical="true"
                android:text="&lt;"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Chi tiết sản phẩm"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/cartHeader"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/cart_icon"
                android:background="@android:color/transparent" />

        </RelativeLayout>

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="fitCenter"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"/>

        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:padding="16dp"
            android:paddingTop="15dp" />

        <TextView
            android:id="@+id/detailPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textColor="#F04A13"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/buyNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mua ngay"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F04A13"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/addToCart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thêm vào giỏ"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F04A13"
                android:padding="12dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#444444"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="250dp"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="10dp" />

        <TextView
            android:id="@+id/detailSpecification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#444444"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="250dp"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Các sản phẩm khác"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/relatedRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="8dp" />

    </LinearLayout>

</ScrollView>
